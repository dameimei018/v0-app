# 复制这个文件为 .env 并填入你的真实信息
# cp .env.example .env

# @BotFather 创建机器人后给你的 token
BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxxx

# 你自己的 Telegram 数字 ID（机器人主管理员）
# 获取方法：把机器人启动后给它发 /myid，或找 @userinfobot 获取
ADMIN_ID=123456789

# 接收下架通知的频道：可以是 @频道用户名，或 -100 开头的频道数字ID
# 注意：必须把机器人拉进该频道并设为管理员
CHANNEL_ID=@your_channel

# 检测间隔（秒）。180 = 3 分钟
CHECK_INTERVAL=180

# 连续几次查不到才判定为下架（防止网络抖动误报）。
# 2 表示需要连续两轮都查不到，配合 180 秒约 6 分钟内确认。
# 想更快可设为 1（约 3 分钟内通知，但偶发误报概率略高）。
REMOVAL_CONFIRMATIONS=2

# 监控的商店地区，美区填 us
COUNTRY=us

# 数据库文件路径
DB_PATH=monitor.db
